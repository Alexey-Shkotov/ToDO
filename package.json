{
  "name": "witcher-journal",
  "version": "1.0.0",
  "description": "The Witcher's Journal — Gamified Task Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.witcherjournal.app",
    "productName": "Witcher's Journal",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.js",
      "preload.js"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
